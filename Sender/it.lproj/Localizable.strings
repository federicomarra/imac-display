/* Settings */
"Display" = "Schermo";
"The iMac is a separate screen, like a monitor on HDMI: change its resolution and arrangement in System Settings → Displays." = "L'iMac è uno schermo separato, come un monitor collegato in HDMI: cambia risoluzione e disposizione in Impostazioni di Sistema → Schermi.";
"Quality" = "Qualità";
"When the connection can't keep up" = "Quando la connessione non regge";
"Lower the frame rate (keeps text sharp)" = "Abbassa il frame rate (testo sempre nitido)";
"Lower the resolution (keeps motion smooth)" = "Abbassa la risoluzione (movimento fluido)";
"Compress more (keeps both, more artifacts)" = "Comprimi di più (mantiene entrambi, più artefatti)";
"Maximum frame rate" = "Frame rate massimo";
"Maximum bitrate: %lld Mbit/s" = "Bitrate massimo: %lld Mbit/s";
"Wi-Fi usually manages 20–40 Mbit/s; Ethernet and Thunderbolt 60–100 Mbit/s." = "Il Wi-Fi di solito regge 20–40 Mbit/s; Ethernet e Thunderbolt 60–100 Mbit/s.";
"Video codec" = "Codec video";
"Automatic" = "Automatico";
"Audio and input" = "Audio e input";
"Play the Mac's sound on the iMac" = "Riproduci l'audio del Mac sull'iMac";
"Control the Mac with the iMac's keyboard and mouse" = "Controlla il Mac con tastiera e mouse dell'iMac";
"iMacDisplay needs the Accessibility permission for this." = "Per questo iMacDisplay ha bisogno del permesso di Accessibilità.";
"Open Settings" = "Apri Impostazioni";
"Connection" = "Connessione";
"Connect automatically to the last iMac" = "Connetti automaticamente all'ultimo iMac";
"Open iMacDisplay at login" = "Apri iMacDisplay al login";
"Forget Paired iMacs" = "Dimentica gli iMac abbinati";
"Connections over a Thunderbolt cable, Ethernet or Wi-Fi are chosen automatically, fastest first." = "Cavo Thunderbolt, Ethernet o Wi-Fi vengono scelti automaticamente, prima il più veloce.";
"Apply Changes Now" = "Applica ora le modifiche";
"Changes to quality, audio and input apply to the next connection, or now with this button." = "Le modifiche a qualità, audio e input valgono dalla prossima connessione, oppure subito con questo pulsante.";

/* Errors */
"Could not reach the iMac." = "Impossibile raggiungere l'iMac.";
"The iMac app is a different version. Install the same version on both computers." = "L'app sull'iMac è di una versione diversa. Installa la stessa versione su entrambi i computer.";
"Wrong code. Check the code on the iMac and try again." = "Codice errato. Controlla il codice sull'iMac e riprova.";
"The iMac closed the connection. Try pairing again." = "L'iMac ha chiuso la connessione. Riprova l'abbinamento.";
"Connection lost. Reconnecting…" = "Connessione persa. Riconnessione…";
"macOS did not allow creating the virtual screen." = "macOS non ha permesso di creare lo schermo virtuale.";
"The screen to capture was not found. Check the Screen Recording permission in System Settings → Privacy & Security." = "Schermo da catturare non trovato. Controlla il permesso Registrazione schermo in Impostazioni di Sistema → Privacy e sicurezza.";
"The hardware video encoder could not be started (error %d)." = "Impossibile avviare il codificatore video hardware (errore %d).";
"System audio could not be captured (%@, error %d). Check “System Audio Recording” in System Settings → Privacy & Security." = "Impossibile catturare l'audio di sistema (%1$@, errore %2$d). Controlla “Registrazione audio di sistema” in Impostazioni di Sistema → Privacy e sicurezza.";

/* Audio output (driver) */
"Install the audio output to pick the iMac in Sound settings, with volume and mute, while connected." = "Installa l'uscita audio per scegliere l'iMac nelle impostazioni Suono, con volume e muto, mentre sei collegato.";
"Install Audio Output…" = "Installa uscita audio…";
"While connected, pick the iMac as the output in Sound settings or in the menu bar." = "Quando sei collegato, scegli l'iMac come uscita nelle impostazioni Suono o nella barra dei menu.";
"This build of iMacDisplay doesn't include the audio driver. Build it with scripts/make-dmg.sh." = "Questa versione di iMacDisplay non contiene il driver audio. Creala con scripts/make-dmg.sh.";
"The audio driver could not be installed." = "Impossibile installare il driver audio.";
